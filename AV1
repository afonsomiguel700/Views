CREATE VIEW vw_total_cliente AS
SELECT
    c.nome_completo AS nome_cliente,
    COUNT(p.id) AS quantidade_pedidos,
    SUM(p.valor) AS valor_total_gasto
FROM cliente c
JOIN pedido p ON p.cliente_id = c.id
GROUP BY c.id, c.nome_completo;


select*from vw_total_cliente;


