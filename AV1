CREATE VIEW vw_desempenho_vendedores AS
SELECT
    v.nome_completo AS nome_vendedor,
    COUNT(vd.id) AS quantidade_venda,
    SUM(vd.valor) AS valor_total_vendido,
    AVG(vd.valor) AS valor_medio_venda,
    MAX(vd.valor) AS maior_venda
FROM VENDEDOR v
JOIN VENDA vd ON vd.vendedor_id = v.id
GROUP BY v.id, v.nome_completo;

SELECT*FROM vw_desempenho_vendedores;
